addFriendBtn.MouseButton1Click:Connect(function()
    local name = friendInput.Text:gsub("^%s+", ""):gsub("%s+$", "")
    if name == "" then return end
    
    local count = 0
    for _ in pairs(TixSettings.Friends) do count = count + 1 end
    if count >= 5 then
        warningLabel.Text = "Max 5 friends allowed!"
        warningLabel.Visible = true
        return
    end
    
    if TixSettings.Friends[name] then
        warningLabel.Text = "Already in list!"
        warningLabel.Visible = true
        return
    end
    
    TixSettings.Friends[name] = true
    friendInput.Text = ""
    refreshFriendList()
    warningLabel.Visible = false
end)

refreshFriendList()

