-- ========== FUNCTIONS ==========

local function isFriend(targetCharacter)
    local player = Players:GetPlayerFromCharacter(targetCharacter)
    if not player then return false end
    
    for friendName in pairs(TixSettings.Friends) do
        if player.Name:lower() == friendName:lower() or player.DisplayName:lower() == friendName:lower() then
            return true
        end
    end
    return false
end

local function createHitbox(player)
    if hitboxParts[player] then return end
    if not player.Character then return end
    
    local head = player.Character:FindFirstChild("Head")
    if not head then return end
    
    local size = TixSettings.HitboxSize
    
    local hitbox = Instance.new("Part")
    hitbox.Name = "KuzeyHitbox"
    hitbox.Size = Vector3.new(size, size, size)
    hitbox.Transparency = 1
    hitbox.CanCollide = false
    hitbox.CanQuery = false
    hitbox.CanTouch = false
    hitbox.Massless = true
    hitbox.Anchored = false
    hitbox.Parent = player.Character
    
    local weld = Instance.new("Weld")
    weld.Name = "KuzeyHitboxWeld"
    weld.Part0 = head
    weld.Part1 = hitbox
    weld.C0 = CFrame.new(0, 0, 0)
    weld.Parent = hitbox
    
    hitboxParts[player] = hitbox
end

local function updateHitboxes()
    for _, player in pairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        
        if hitboxParts[player] and (not player.Character or not hitboxParts[player].Parent or hitboxParts[player].Parent ~= player.Character) then
            local old = hitboxParts[player]
            hitboxParts[player] = nil
            pcall(function() old:Destroy() end)
        end
        
        if not player.Character then continue end
        
        if TixSettings.HitboxEnabled then
            if not hitboxParts[player] then
                createHitbox(player)
            end
            if hitboxParts[player] then
                local size = TixSettings.HitboxSize
                hitboxParts[player].Size = Vector3.new(size, size, size)
            end
        else
            if hitboxParts[player] then
                local old = hitboxParts[player]
                hitboxParts[player] = nil
                pcall(function() old:Destroy() end)
            end
        end
    end
end

local function canSeeTarget(targetPart)
    if not TixSettings.WallCheck then return true end
    
    local origin = Camera.CFrame.Position
    local direction = (targetPart.Position - origin)
    local maxDist = direction.Magnitude
    direction = direction.Unit * maxDist
    
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Blacklist
    params.FilterDescendantsInstances = {LocalPlayer.Character}
    params.IgnoreWater = true
    
    local result = workspace:Raycast(origin, direction, params)
    
    if not result then return true end
    
    local hit = result.Instance
    if hit then
        local hitChar = hit:FindFirstAncestorWhichIsA("Model")
        if hitChar then
            if hitChar == targetPart.Parent then return true end
            if hitChar:FindFirstChild("KuzeyHitbox") then return true end
        end
    end
    
    return false
end

local function getTargetPart(player)
    if not player.Character then return nil end
    
    if TixSettings.HitboxEnabled and hitboxParts[player] and hitboxParts[player].Parent == player.Character then
        return hitboxParts[player]
    end
    return player.Character:FindFirstChild("Head") or player.Character:FindFirstChild("HumanoidRootPart")
end

local function getClosest()
    local target, shortestFOV = nil, TixSettings.FOV
    local camPos = Camera.CFrame.Position
    local maxDist = TixSettings.MaxDistance
    local mousePos = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    
    if TixSettings.Closest then
        local closestDist = math.huge
        for _, v in pairs(Players:GetPlayers()) do
            if v == LocalPlayer then continue end
            if not v.Character then continue end
            
            if hitboxParts[v] and (not hitboxParts[v].Parent or hitboxParts[v].Parent ~= v.Character) then
                local old = hitboxParts[v]
                hitboxParts[v] = nil
                pcall(function() old:Destroy() end)
            end
            
            local humanoid = v.Character:FindFirstChild("Humanoid")
            if not humanoid then continue end
            
            if isFriend(v.Character) then continue end
            if TixSettings.TeamCheck and v.Team == LocalPlayer.Team then continue end
            
            local targetPart = getTargetPart(v)
            if not targetPart then continue end
            
            local dist = (targetPart.Position - camPos).Magnitude
            if dist > maxDist then continue end
            
            if not canSeeTarget(targetPart) then continue end
            
            if dist < closestDist then
                closestDist = dist
                target = targetPart
            end
        end
        return target
    end
    
    for _, v in pairs(Players:GetPlayers()) do
        if v == LocalPlayer then continue end
        if not v.Character then continue end
        
        if hitboxParts[v] and (not hitboxParts[v].Parent or hitboxParts[v].Parent ~= v.Character) then
            local old = hitboxParts[v]
            hitboxParts[v] = nil
            pcall(function() old:Destroy() end)
        end
        
        local humanoid = v.Character:FindFirstChild("Humanoid")
        if not humanoid then continue end
        
        if isFriend(v.Character) then continue end
        if TixSettings.TeamCheck and v.Team == LocalPlayer.Team then continue end
        
        local targetPart = getTargetPart(v)
        if not targetPart then continue end
        
        local dist = (targetPart.Position - camPos).Magnitude
        if dist > maxDist then continue end
        
        if not canSeeTarget(targetPart) then continue end
        
        local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
        if not onScreen then continue end
        
        local mag = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
        if mag < shortestFOV then 
            target = targetPart
            shortestFOV = mag
        end
    end
    
    return target
end

-- ========== LOCKED TARGET ==========
local LockedTarget = nil

-- AIM MODE LOGIC
local aimActive = false
local autoMode = false

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    
    local key = TixSettings.AimKey
    local match = false
    
    if typeof(key) == "EnumItem" and key.EnumType == Enum.KeyCode then
        if input.KeyCode == key then match = true end
    elseif typeof(key) == "EnumItem" and key.EnumType == Enum.UserInputType then
        if input.UserInputType == key then match = true end
    end
    
    if match then
        if TixSettings.AimMode == "Toggle" then
            aimActive = not aimActive
            if not aimActive then LockedTarget = nil end
        elseif TixSettings.AimMode == "Hold" then
            aimActive = true
        elseif TixSettings.AimMode == "Auto" then
            autoMode = not autoMode
            aimActive = autoMode
            if not aimActive then LockedTarget = nil end
        end
        
        local status = aimActive and "ACIK" or "KAPALI"
        if not TixUI:FindFirstChild("StatusLabel") then
            local sl = Instance.new("TextLabel", TixUI)
            sl.Name = "StatusLabel"
            sl.Size = UDim2.new(0, 180, 0, 25)
            sl.Position = UDim2.new(0, 10, 1, -35)
            sl.BackgroundTransparency = 1
            sl.Font = Enum.Font.GothamBold
            sl.TextColor3 = PrimaryRed
            sl.TextSize = 14
            sl.Text = "AIM: " .. status
        else
            TixUI.StatusLabel.Text = "AIM: " .. status
        end
    end
end)

UserInputService.InputEnded:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    
    if TixSettings.AimMode == "Hold" then
        local key = TixSettings.AimKey
        local match = false
        
        if typeof(key) == "EnumItem" and key.EnumType == Enum.KeyCode then
            if input.KeyCode == key then match = true end
        elseif typeof(key) == "EnumItem" and key.EnumType == Enum.UserInputType then
            if input.UserInputType == key then match = true end
        end
        
        if match then
            aimActive = false
            LockedTarget = nil
            if TixUI:FindFirstChild("StatusLabel") then
                TixUI.StatusLabel.Text = "AIM: KAPALI"
            end
        end
    end
end)

-- MAIN LOOP
RunService.RenderStepped:Connect(function()
    if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("Humanoid") or LocalPlayer.Character.Humanoid.Health <= 0 then
        for char, visual in pairs(visualCache) do
            if visual.High then
                visual.High:Destroy()
            end
            if visual.NameTag then
                visual.NameTag:Destroy()
            end
        end
        visualCache = {}
        return
    end

    local accent = TixSettings.RainbowStyle and getRainbow() or PrimaryRed

    Circle.Radius = TixSettings.FOV
    Circle.Position = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    Circle.Color = accent
    MainStroke.Color = accent
    ToggleStroke.Color = accent
    Title.TextColor3 = Color3.fromRGB(255, 255, 255)
    Circle.Visible = TixSettings.CircleVis

    if TixSettings.AimMode == "Auto" and autoMode then
        aimActive = true
    end

    updateHitboxes()

    -- LOCKED TARGET (FOV kontrolü yok)
    if TixSettings.Sticky and aimActive then
        local targetToAim = nil

        if LockedTarget then
            local valid = false
            if LockedTarget and LockedTarget.Parent and LockedTarget.Parent:IsA("Model") then
                local player = Players:GetPlayerFromCharacter(LockedTarget.Parent)
                if player and player ~= LocalPlayer then
                    local humanoid = LockedTarget.Parent:FindFirstChild("Humanoid")
                    if humanoid and humanoid.Health > 0 then
                        local dist = (LockedTarget.Position - Camera.CFrame.Position).Magnitude
                        if dist <= TixSettings.MaxDistance then
                            if canSeeTarget(LockedTarget) then
                                valid = true
                            end
                        end
                    end
                end
            end

            if valid then
                targetToAim = LockedTarget
            else
                LockedTarget = nil
            end
        end

        if not LockedTarget then
            local newTarget = getClosest()
            if newTarget then
                LockedTarget = newTarget
                targetToAim = newTarget
            end
        end

        if targetToAim then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetToAim.Position)
        end
    else
        LockedTarget = nil
    end

    -- ESP & Nametags
    for _, p in pairs(Players:GetPlayers()) do 
        if p ~= LocalPlayer then
            local char = p.Character
            local humanoid = char and char:FindFirstChildOfClass("Humanoid")
            
            if not char or not humanoid or humanoid.Health <= 0 then
                if visualCache[char] then
                    if visualCache[char].High then
                        visualCache[char].High:Destroy()
                    end
                    if visualCache[char].NameTag then
                        visualCache[char].NameTag:Destroy()
                    end
                    visualCache[char] = nil
                end
            else
                local isF = isFriend(char)
                
                if not visualCache[char] then
                    local high = Instance.new("Highlight")
                    high.Adornee = char
                    high.Parent = TixUI
                    
                    local nameTag = Instance.new("BillboardGui")
                    nameTag.Name = "NameTag"
                    nameTag.Adornee = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
                    nameTag.Size = UDim2.new(0, 120, 0, 30)
                    nameTag.StudsOffset = Vector3.new(0, 2.5, 0)
                    nameTag.Parent = TixUI
                    nameTag.AlwaysOnTop = true
                    nameTag.MaxDistance = 700
                    
                    local nameLabel = Instance.new("TextLabel", nameTag)
                    nameLabel.Size = UDim2.new(1, 0, 1, 0)
                    nameLabel.BackgroundTransparency = 1
                    nameLabel.Text = p.DisplayName or p.Name
                    nameLabel.Font = Enum.Font.GothamBold
                    nameLabel.TextSize = 14
                    nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
                    nameLabel.TextStrokeTransparency = 0.3
                    nameLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
                    
                    visualCache[char] = {High = high, NameTag = nameTag}
                end
                
                local visual = visualCache[char]
                if visual then
                    if visual.High then
                        visual.High.Enabled = TixSettings.ESP and char:FindFirstChild("Head") ~= nil
                        visual.High.Adornee = char
                        if isF then
                            visual.High.FillColor = GreenColor
                        else
                            visual.High.FillColor = accent
                        end
                        visual.High.OutlineColor = Color3.new(1, 1, 1)
                    end
                    
                    if visual.NameTag then
                        visual.NameTag.Enabled = TixSettings.NameTags
                        local head = char:FindFirstChild("Head")
                        visual.NameTag.Adornee = head or char:FindFirstChild("HumanoidRootPart")
                        if head then
                            visual.NameTag.StudsOffset = Vector3.new(0, 2.5, 0)
                        else
                            visual.NameTag.StudsOffset = Vector3.new(0, 1, 0)
                        end
                        
                        local nameLabel = visual.NameTag:FindFirstChildOfClass("TextLabel")
                        if nameLabel then
                            nameLabel.Text = p.DisplayName or p.Name
                            if isF then
                                nameLabel.TextColor3 = GreenColor
                            else
                                nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
                            end
                        end
                    end
                end
            end
        end 
    end
end)
