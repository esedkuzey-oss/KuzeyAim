    label.TextSize = 14
    label.TextXAlignment = Enum.TextXAlignment.Left

    local keyBtn = Instance.new("TextButton", frame)
    keyBtn.Size = UDim2.new(0, 100, 0, 30)
    keyBtn.Position = UDim2.new(1, -110, 0.5, -15)
    keyBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
    keyBtn.Text = tostring(TixSettings[settingKey]):gsub("Enum.KeyCode.", ""):gsub("Enum.UserInputType.", "")
    keyBtn.Font = Enum.Font.GothamBold
    keyBtn.TextColor3 = PrimaryRed
    keyBtn.TextSize = 12
    Instance.new("UICorner", keyBtn)

    local waiting = false
    keyBtn.MouseButton1Click:Connect(function()
        waiting = true
        keyBtn.Text = "..."
    end)

    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if waiting and not gameProcessed then
            if input.UserInputType == Enum.UserInputType.MouseButton1 or
               input.UserInputType == Enum.UserInputType.MouseButton2 or
               input.UserInputType == Enum.UserInputType.MouseButton3 then
                TixSettings[settingKey] = input.UserInputType
                keyBtn.Text = tostring(input.UserInputType):gsub("Enum.UserInputType.", "")
                waiting = false
            elseif input.KeyCode ~= Enum.KeyCode.Unknown then
                TixSettings[settingKey] = input.KeyCode
                keyBtn.Text = tostring(input.KeyCode):gsub("Enum.KeyCode.", "")
                waiting = false
            end
        end
    end)

    return frame
end

