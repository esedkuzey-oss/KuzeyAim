local function CreateCollapsible(title, parent)
    local header = Instance.new("TextButton", parent)
    header.Size = UDim2.new(1, -5, 0, 30)
    header.BackgroundColor3 = Color3.fromRGB(35, 35, 40)
    header.Text = ""
    header.AutoButtonColor = false
    Instance.new("UICorner", header)
    
    local headerLabel = Instance.new("TextLabel", header)
    headerLabel.Size = UDim2.new(0.8, -10, 1, 0)
    headerLabel.Position = UDim2.new(0, 10, 0, 0)
    headerLabel.BackgroundTransparency = 1
    headerLabel.Text = title
    headerLabel.Font = Enum.Font.GothamBold
    headerLabel.TextColor3 = PrimaryRed
    headerLabel.TextSize = 13
    headerLabel.TextXAlignment = Enum.TextXAlignment.Left
    
    local arrow = Instance.new("TextLabel", header)
    arrow.Name = "Arrow"
    arrow.Size = UDim2.new(0, 20, 1, 0)
    arrow.Position = UDim2.new(1, -25, 0, 0)
    arrow.BackgroundTransparency = 1
    arrow.Text = ">"
    arrow.Font = Enum.Font.GothamBold
    arrow.TextColor3 = PrimaryRed
    arrow.TextSize = 16
    arrow.TextXAlignment = Enum.TextXAlignment.Center
    
    local expanded = false
    local container = Instance.new("Frame", parent)
    container.Size = UDim2.new(1, -5, 0, 0)
    container.BackgroundTransparency = 1
    container.Visible = false
    container.ClipsDescendants = true
    
    local containerList = Instance.new("UIListLayout", container)
    containerList.Padding = UDim.new(0, 4)
    
    local function updateContainerSize()
        local h = 0
        for _, child in ipairs(container:GetChildren()) do
            if child:IsA("Frame") or child:IsA("TextButton") then
                h = h + child.Size.Y.Offset + 4
            end
        end
        container.Size = UDim2.new(1, -5, 0, h)
    end
    
    header.MouseButton1Click:Connect(function()
        expanded = not expanded
        arrow.Text = expanded and "v" or ">"
        container.Visible = expanded
        if expanded then
            updateContainerSize()
        end
    end)
    
    return {
        Header = header,
        Container = container,
        Update = updateContainerSize
    }
end

