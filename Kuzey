    local modeBtn = Instance.new("TextButton", frame)
    modeBtn.Size = UDim2.new(0, 80, 0, 30)
    modeBtn.Position = UDim2.new(1, -90, 0.5, -15)
    modeBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
    modeBtn.Text = TixSettings[settingKey]
    modeBtn.Font = Enum.Font.GothamBold
    modeBtn.TextColor3 = PrimaryRed
    modeBtn.TextSize = 12
    Instance.new("UICorner", modeBtn)

    local currentIndex = 1
    for i, v in ipairs(options) do
        if v == TixSettings[settingKey] then currentIndex = i; break end
    end

    modeBtn.MouseButton1Click:Connect(function()
        currentIndex = currentIndex + 1
        if currentIndex > #options then currentIndex = 1 end
        TixSettings[settingKey] = options[currentIndex]
        modeBtn.Text = options[currentIndex]
    end)

    return frame
end

